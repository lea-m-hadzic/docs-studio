# Documentation site (GitHub Pages).
#
# Generated by docs-studio {{ version }} — a MANAGED file.
{%- if deploy.trigger == "manual" %}
# Manual only: run it from the Actions tab when the docs are to be published. Nothing
# publishes on its own, so a push can never change the live site.
{%- else %}
# Publishes on every push to {{ deploy.branch }}, and can also be run from the Actions
# tab. The build is strict, so a broken link fails the run instead of going live.
{%- endif %}
#
# One-time setup, in the repository's Settings → Pages: set Source to "GitHub Actions".
# Until that is done the deploy step fails with a "Pages site not found" error.
name: Documentation
on:
{%- if deploy.trigger == "push" %}
  push:
    branches:
      - {{ deploy.branch }}
{%- endif %}
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ '${{ steps.deployment.outputs.page_url }}' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/configure-pages@v6
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v6
        with:
          python-version: {{ deploy.python_version | tq }}
      - run: pip install "zensical=={{ deploy.zensical_version }}"
{%- for line in deploy.extra_install %}
      - run: {{ line }}
{%- endfor %}
      # The checker runs when docs-studio is available in this job. Install it with a
      # deploy.extra_install line in docs-studio.toml — `pip install .` for a Python
      # project that depends on it, or `pip install docs-studio` once it is published.
      - name: docs-studio check
        run: |
          if command -v docs-studio > /dev/null; then
            docs-studio check --no-build
          else
            echo "docs-studio is not installed in this job, so the checker did not run."
            echo "Add it under deploy.extra_install in docs-studio.toml to run it here."
          fi
      - run: zensical build --clean --strict
      - uses: actions/upload-pages-artifact@v5
        with:
          path: site
      - uses: actions/deploy-pages@v5
        id: deployment
