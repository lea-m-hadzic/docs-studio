# Documentation site for {{ project.name }}.
#
# Generated by docs-studio {{ version }} — a MANAGED file. It is derived entirely from
# docs-studio.toml; change that file and run `docs-studio update`. Edits here are
# reported as a conflict and are not overwritten.
#
# Build: pip install "zensical=={{ deploy.zensical_version }}" && zensical build --strict
[project]
site_name = {{ project.name | tq }}
site_description = {{ project.description | tq }}
site_author = {{ project.author | tq }}
site_url = {{ project.site_url | tq }}
edit_uri = ""
{%- if project.copyright %}
copyright = {{ project.copyright | tq }}
{%- endif %}
docs_dir = "docs"
site_dir = "site"
# The second stylesheet is yours; it loads after the generated one.
extra_css = [{% for sheet in stylesheets %}{{ sheet | tq }}{{ ", " if not loop.last }}{% endfor %}]

nav = [
{%- for entry in nav %}
  {%- if entry.is_section %}
  { {{ entry.title | tq }} = [
    {%- for label, page in entry.labelled_pages %}
    { {{ label | tq }} = {{ page | tq }} },
    {%- endfor %}
  ] },
  {%- else %}
  { {{ entry.title | tq }} = {{ entry.page | tq }} },
  {%- endif %}
{%- endfor %}
]

[project.theme]
language = "en"
{%- if logo_ref %}
logo = {{ logo_ref | tq }}
{%- endif %}
{%- if favicon_ref %}
favicon = {{ favicon_ref | tq }}
{%- endif %}
font = false                      # system fonts: no third-party font requests
features = [
{%- for feature in features %}
  {{ feature | tq }},
{%- endfor %}
]

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
primary = {{ palette.md_primary | tq }}
accent = {{ palette.md_accent | tq }}
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
primary = {{ palette.md_primary_dark | tq }}
accent = {{ palette.md_accent | tq }}
toggle.icon = "lucide/moon"
toggle.name = "Switch to light mode"

[project.markdown_extensions]
admonition = {}
attr_list = {}
md_in_html = {}
tables = {}
toc.permalink = true
pymdownx.details = {}
pymdownx.emoji = { emoji_index = "zensical.extensions.emoji.twemoji", emoji_generator = "zensical.extensions.emoji.to_svg" }  # theme icons, e.g. :simple-github:
pymdownx.highlight.anchor_linenums = true
pymdownx.highlight.pygments_lang_class = true
pymdownx.inlinehilite = {}
pymdownx.snippets.base_path = ["."]
pymdownx.snippets.check_paths = true
pymdownx.superfences = {}
